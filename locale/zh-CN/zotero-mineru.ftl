zotero-mineru-menu-root =
    .label = MinerU
zotero-mineru-menu-parse-pdf =
    .label = 使用 MinerU 解析 PDF 并保存为附件
zotero-mineru-menu-markdown-to-note =
    .label = 将 MinerU 解析附件转为笔记
zotero-mineru-menu-ai-summary =
    .label = 使用 AI 总结文献
zotero-mineru-menu-ai-translate =
    .label = 使用 AI 翻译文献

mineru-pref-title = MinerU PDF 解析设置
mineru-pref-api-base-url = API Base URL
mineru-pref-api-token = API Token
mineru-pref-api-token-input =
    .placeholder = MinerU 控制台生成的 token
mineru-pref-model-version = 模型版本
mineru-pref-parse-generate-html = 同时生成 HTML（始终保留 Markdown）
mineru-pref-parse-markdown-help = 原始解析 Markdown 始终保存在附件目录中。未勾选时，Markdown 直接显示为 Zotero 附件；勾选 HTML 后，显示的是 HTML 主附件，请右键该附件并打开所在文件夹，查看同目录中的 .md 文件。AI 总结和翻译始终读取原始 Markdown。
mineru-pref-parse-image-mode = HTML 图片保存方式
mineru-pref-image-mode-folder =
    .label = 独立 images 文件夹
mineru-pref-image-mode-inline =
    .label = Base64 内嵌（单文件）
mineru-pref-parse-link-source-pdf = 自动关联源 PDF 与解析附件
mineru-pref-related-help = 默认开启，在源 PDF 与生成的 Markdown 或 HTML 主附件之间建立双向 Related Item 关联。仅影响后续解析；关闭不会删除已有关系，也不自动补关联历史附件。
mineru-pref-note-include-images = 转化笔记时带图
mineru-pref-poll-interval-sec = 轮询间隔(秒)
mineru-pref-timeout-sec = 请求超时(秒)
mineru-pref-note-title-prefix = 笔记标题前缀
mineru-pref-llm-heading = LLM 设置（AI 总结 / 翻译功能）
mineru-pref-llm-api-base-url = LLM API Base URL
mineru-pref-llm-api-key = LLM API Key
mineru-pref-llm-model = LLM 模型名称
mineru-pref-summary-language = 总结语言
mineru-pref-summary-prompt = AI 总结 Prompt
mineru-pref-summary-prompt-textarea =
    .placeholder = 例如：请用 {{language}} 总结论文的研究问题、核心方法、创新点和局限性。
mineru-pref-summary-prompt-help = 留空使用默认总结提示词；填写后替换默认系统提示词。{{language}} 会替换为所选总结语言，论文正文会自动附加，无需粘贴。清空并保存可恢复默认。
mineru-pref-summary-request-json = 总结额外 JSON 参数
mineru-pref-translate-output-format = 翻译保存格式
mineru-pref-translate-format-html =
    .label = 单文件 HTML
mineru-pref-translate-mode = 翻译模式
mineru-pref-translate-mode-translation =
    .label = 仅译文
mineru-pref-bilingual-option =
    .label = 原文译文双栏对照（仅 HTML）
mineru-pref-translate-language = 翻译目标语言
mineru-pref-translate-chunk-size = 翻译分段字符数
mineru-pref-translate-concurrency = 翻译并发请求数
mineru-pref-translate-retry-count = 翻译自动重试次数
mineru-pref-translate-request-json = 翻译额外 JSON 参数
mineru-pref-save-button = 保存
mineru-pref-test-button = 测试 MinerU 连接
mineru-pref-test-llm-button = 测试当前 LLM 配置
mineru-pref-bottom-help = 解析和翻译可分别选择 Markdown / HTML 与图片保存方式。双栏对照仅支持 HTML；切换为 Markdown 会恢复仅译文。Markdown 内嵌图片的显示效果取决于阅读器。分离图片位于附件的 images 文件夹；已有附件不自动转换。
